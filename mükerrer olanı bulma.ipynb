import pandas as pd
from openpyxl import load_workbook
from openpyxl.styles import PatternFill

df = pd.read_excel("ornek_veri_50.xlsx")
duplicates = df[df.duplicated(subset=["KişiID"], keep=False)].sort_values(by="KişiID")
duplicates.to_excel("mukerrerler.xlsx", index=False)

wb = load_workbook("mukerrerler.xlsx")
ws = wb.active
yellow_fill = PatternFill(start_color="FFFF00", end_color="FFFF00", fill_type="solid")

current_id = None
toggle_color = False

for row in range(2, ws.max_row + 1):
    cell_value = ws[f"A{row}"].value
    if cell_value != current_id:
        current_id = cell_value
        toggle_color = not toggle_color
    if toggle_color:
        for col in range(1, ws.max_column + 1):
            ws.cell(row=row, column=col).fill = yellow_fill

wb.save("mukerrerler_renkli.xlsx")
print("✅ İşlem tamamlandı: mukerrerler_renkli.xlsx")
